<?xml version="1.0" encoding="utf-8"?>
<!-- Sofy (20/11/2026): frases dos recados do Observador, uma por tipo (ObserverCore.noteFor: observer_<tipo>_title/_text). %1$s = o número do sinal. -->
<resources>
    <string name="observer_no_internet_title">인터넷 연결 없음</string>
    <string name="observer_no_internet_text">다시 연결될 때까지 동영상이 멈출 수 있어요.</string>
    <string name="observer_slow_internet_title">인터넷이 느려요</string>
    <string name="observer_slow_internet_text">응답에 %1$s ms 걸려요. 동영상이 로딩으로 멈출 수 있어요.</string>
    <string name="observer_weak_wifi_title">Wi-Fi 신호 약함</string>
    <string name="observer_weak_wifi_text">신호가 %1$s dBm이에요. 공유기를 TV 가까이 두면 좋아져요.</string>
    <string name="observer_low_memory_title">메모리가 거의 가득 참</string>
    <string name="observer_low_memory_text">여유 공간이 %1$s MB뿐이에요. 앱이 닫힐 수 있어요.</string>
    <string name="observer_memory_pressure_title">TV에 부하가 많아요</string>
    <string name="observer_memory_pressure_text">Android가 공간을 만들려고 앱을 닫고 있어요.</string>
    <string name="observer_slow_home_title">홈 화면이 느려요</string>
    <string name="observer_slow_home_text">프레임의 %1$s%%가 늦었어요.</string>
    <string name="observer_low_disk_title">저장 공간이 거의 가득 참</string>
    <string name="observer_low_disk_text">%1$s MB만 남았어요. 저장이 실패할 수 있어요.</string>
    <string name="observer_freeze_undone_title">정지를 되돌렸습니다</string>
    <string name="observer_freeze_undone_text">%1$s을(를) 정지했더니 %2$s이(가) 작동하지 않아 다시 켰습니다.</string>
    <string name="observer_wifi_restarted_title">Wi-Fi를 다시 켰습니다</string>
    <string name="observer_wifi_restarted_text">TV가 %1$s분 동안 Wi-Fi 없이 있었습니다. 껐다 켰더니 돌아왔습니다.</string>
    <string name="observer_tv_restarted_title">TV를 다시 시작했습니다</string>
    <string name="observer_tv_restarted_text">Wi-Fi가 %1$s분 동안 끊겼고 껐다 켜도 안 돼서 TV를 다시 시작했습니다.</string>
    <string name="observer_remote_battery_low_title">리모컨 배터리 부족</string>
    <string name="observer_remote_battery_low_text">리모컨 배터리가 %1$s%%입니다. 이번 주에 교체하거나 충전하세요.</string>
    <string name="observer_app_on_demand_title">앱을 필요할 때만 켜지게 했어요</string>
    <string name="observer_app_on_demand_text">%1$s 앱을 3주 동안 열지 않았어요. 이제 열 때만 켜져요.</string>
    <string name="observer_version_slower_title">새 버전이 더 느려졌어요</string>
    <string name="observer_version_slower_text">홈 화면이 열리는 데 %1$s초 걸려요(이전 %2$s초). 다음 버전에서 고치도록 기록했어요.</string>
    <string name="observer_app_crashy_title">%1$s 앱이 자꾸 멈춰요</string>
    <string name="observer_app_crashy_text">%1$s 앱이 이번 주에 %2$s번 멈췄어요.</string>
    <string name="observer_app_crashy_update_title">%1$s 앱이 자꾸 멈춰요</string>
    <string name="observer_app_crashy_update_text">%1$s 앱이 새 버전 이후 이번 주에 %2$s번 멈췄어요.</string>
    <string name="observer_wifi_advice_title">Wi-Fi가 더 좋아질 수 있어요</string>
    <string name="observer_wifi_advice_text">이번 주 인터넷이 %1$s번 끊겼어요. 공유기에서 바꿀 점을 TV 일지(웹 패널)에 적어 두었어요.</string>
    <string name="observer_game_lag_title">클라우드 게임에는 인터넷이 느려요</string>
    <string name="observer_game_lag_text">지금 지연이 %1$s ms로 이 집 평소보다 훨씬 높아요. 클라우드 게임이 끊길 수 있어요.</string>
    <string name="observer_tv_wake_failing_title">알람으로 TV가 켜지지 않았어요</string>
    <string name="observer_tv_wake_failing_text">이번 주 %1$s번의 아침에 TV가 알람에 반응하지 않았어요. TV 설정에서 HDMI-CEC(LG는 SimpLink)가 켜져 있는지 확인하세요.</string>
    <string name="observer_home_hub_failing_title">Home Assistant가 실패하고 있어요</string>
    <string name="observer_home_hub_failing_text">지난 하루 동안 Home Assistant 명령 %1$s개가 실패했어요. 켜져 있고 연결되는지 확인하세요.</string>
    <string name="observer_key_stuck_title">리모컨 버튼이 눌린 채로 있어요</string>
    <string name="observer_key_stuck_text">%1$s 버튼이 7초 넘게 눌려 있었어요. 리모컨이 쿠션 밑에 있을 수 있어요.</string>
    <string name="observer_app_powerful_title">권한이 많은 새 앱</string>
    <string name="observer_app_powerful_text">%1$s 앱이 방금 설치되었고 강한 권한 %2$s개를 요청해요. 직접 설치한 게 아니라면 설정 > 앱에서 삭제하세요.</string>
    <string name="observer_system_update_broke_title">Google 업데이트로 문제가 생겼어요</string>
    <string name="observer_system_update_broke_text">Google 업데이트 직후 %1$s개 기능이 멈췄어요(음성 검색, 스토어, Cast 등). 자세한 내용은 TV 일지에 있어요.</string>
    <string name="observer_panel_pin_wrong_title">웹 패널에서 PIN 오류</string>
    <string name="observer_panel_pin_wrong_text">지난 1시간 동안 PIN이 %1$s번 틀렸어요. 본인이 아니라면 패널 PIN을 바꾸세요.</string>
    <string name="observer_disk_filling_title">저장 공간이 차고 있어요</string>
    <string name="observer_disk_filling_text">이 속도라면 약 %1$s일 뒤 공간이 부족해져요. 오래된 녹화나 앱 캐시를 지우세요.</string>
</resources>
