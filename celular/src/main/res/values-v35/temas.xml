<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 com targetSdk 35 desenha atrás das barras do sistema; as telas (Views à mão) não tratam os
         recuos, então o topo e o rodapé ficavam escondidos. Opta por fora até as telas tratarem os insets. -->
    <style name="Tema" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:alertDialogTheme">@style/Dialogo</item>
    </style>
</resources>
