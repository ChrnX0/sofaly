    <string name="observer_low_memory_title">الذاكرة ممتلئة تقريبًا</string>
    <string name="observer_low_memory_text">المتاح %1$s ميغابايت فقط. قد تُغلق التطبيقات.</string>
    <string name="observer_memory_pressure_title">التلفاز محمّل فوق طاقته</string>
