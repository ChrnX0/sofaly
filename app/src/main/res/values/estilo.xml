<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo da janela grafite neutro #121212 (27/11/2026: era azul-marinho #0E1020, contra a regra "escuro nunca azulado"). Temas do launcher (sistema de design, 10/11/2026). Os três herdam os temas do Android que o manifesto já usava
     e só acrescentam a fonte Manrope e a cor de fundo. Ver Estilo.kt para cores, tamanhos e componentes. -->
<resources>
    <style name="One" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:windowBackground">@color/one_fundo</item>
        <item name="android:colorAccent">@color/one_acento</item>
    </style>
    <style name="One.Tela" parent="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:windowBackground">@color/one_fundo</item>
    </style>
    <style name="One.Translucido" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:fontFamily">@font/nunito</item>
    </style>
    <!-- Painel ao lado (25/11/2026): as Configurações abrem translúcidas, por cima da HOME viva. Sem a animação de janela
         do sistema: o painel entra e sai sozinho (SidePanel.kt). Quando o jeito escolhido não é o painel, a tela vira
         opaca na hora (Activity.setTranslucent(false)). -->
    <style name="One.Painel" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:colorAccent">@color/one_acento</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
    <color name="one_fundo">#FF121212</color>
    <color name="one_acento">#FFFF6A2B</color>
</resources>
